# Cloudflare Pages 보안 헤더
# https://developers.cloudflare.com/pages/configuration/headers/
# Vite가 public/ 파일을 dist/로 복사 → Pages가 이 파일을 자동으로 응답 헤더에 적용

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(self), camera=(), payment=(), usb=()
  # script-src sha256: index.html의 manifest 분기 인라인 스크립트 (학생 path가 아닐 때만 manifest link 추가).
  # 스크립트 본문 한 글자라도 바뀌면 hash 재계산 필요 — 브라우저 콘솔에 Refused to execute 에러로 즉시 드러남.
  # cdn.jsdelivr.net (style-src·font-src·connect-src): Pretendard 폰트 CSS — <link>로 로드 + Workbox SW가 fetch해서 캐싱하므로 connect-src도 필요.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-ev4BkAGZQMt++Y2kD1o1eSZ5ogBdiNm6WRilz5Ff+ek='; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; img-src 'self' data: blob: https:; connect-src 'self' https://tutor-manager-proxy.hisyisnis.workers.dev https://api.notion.com https://*.notion.so https://*.notion-static.com https://ntfy.sh https://cdn.jsdelivr.net; media-src 'self' blob: https:; worker-src 'self' blob:; manifest-src 'self' data: blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
