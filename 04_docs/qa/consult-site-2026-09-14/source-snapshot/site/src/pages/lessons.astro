---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.jsx';
import SectionTitle from '../components/SectionTitle.jsx';
import FeatureItem from '../components/FeatureItem.jsx';
import Banner from '../components/Banner.jsx';
import Footer from '../components/Footer.jsx';
import { KAKAO_CHANNEL_CHAT_URL, CONSULT_URL } from '../config.js';
---
<Base title="수업 안내" description="성인 1:1 프라이빗 중국어 회화·발음 교정 튜터링. 대상과 수업 방식을 확인하고 상담을 신청하세요." path="/lessons/">
  <Header client:load active="/lessons/" />

  <main id="main-content" tabindex="-1">
    <section class="section" style="padding-top: 120px">
      <div class="container stack stack--80">
        <SectionTitle as="h1" lead="성인 대상, 시험이 아니라 말하기가 목표인 분과 함께합니다. 1:1 프라이빗 튜터링.">수업 안내</SectionTitle>
        <div class="grid grid--3">
          <FeatureItem label="처음 시작하는 분" body={'성조부터 회화까지,\n가장 빠르고 확실하게\n첫 단추를 끼워드립니다.'} />
          <FeatureItem label="발음이 고민인 분" body={'디테일한 밀착 교정으로\n원어민처럼 당당하게 말하는\n자신감을 찾아드립니다.'} />
          <FeatureItem label="입이 안 떨어지는 분" body={'머리로는 아는데 말이 안 나오는 분.\n눈으로 하는 공부와 입으로 하는\n훈련은 방식부터 다릅니다.'} />
        </div>
        <div class="hard">
          <p class="t-label faint">이런 상담은 어려워요</p>
          <p class="t-body muted">HSK 등 시험 대비, 어린이 수업, 비즈니스 통역 수준의 고급 회화는 맡지 않습니다. 하늘쌤이 가장 잘하는 건 입문에서 중급까지의 회화와 발음 교정이라, 이 경우엔 더 잘 맞는 곳을 권해드려요.</p>
        </div>
      </div>
    </section>

    <section class="section section--warm">
      <div class="container stack stack--80">
        <SectionTitle>1:1로, 지금 필요한 것만</SectionTitle>
        <div class="grid grid--3">
          <FeatureItem label="수업 시간 · 장소" body={'60분 기준, 조정 가능.\n강남 사무실 대면 또는\nZoom 화상.'} />
          <FeatureItem label="수업 형태" body={'1:1 개인 수업이 기본,\n2:1 소그룹도 가능합니다.\n교재 진도가 아니라 맞춤 구성.'} />
          <FeatureItem label="숙제" body={'매 수업 뒤 녹음 숙제 제공.\n들어보고 피드백을 드려\n입에 붙입니다.'} />
        </div>
      </div>
    </section>

    <section class="section section--warm">
      <div class="container stack stack--80">
        <SectionTitle lead="문의는 언제든 남겨 주세요. 공식 응대 시간은 09:00~23:00이며, 답변 가능한 때 확인 후 안내해 드려요.">이렇게 상담해요</SectionTitle>
        <div class="grid grid--3">
          <FeatureItem label="1. 상담 신청" body={'이름과 연락처,\n궁금한 점을 남겨 주세요.'} />
          <FeatureItem label="2. 목표·수준 확인" body={'배워 본 경험과 말하기 목표,\n지금 어려운 점을 함께 확인해요.'} />
          <FeatureItem label="3. 방식·일정 조율" body={'확인한 내용을 바탕으로\n수업 방식과 일정을 조율해요.'} />
        </div>
      </div>
    </section>

    <section class="container" style="padding-block: var(--section-y)">
      <Banner
        title={'내 회화, 어디서 막히는지부터\n함께 짚어볼게요'}
        cta={{ label: '상담 신청하기', href: CONSULT_URL }}
      />
      <p class="t-caption muted" style="margin-top: 24px; text-align: center"><a class="tlink" href={KAKAO_CHANNEL_CHAT_URL} target="_blank" rel="noopener noreferrer">카카오 채널로 문의하기 ↗</a></p>
    </section>
  </main>

  <Footer />
</Base>
