---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import SectionTitle from '../components/SectionTitle.jsx';
import ConsultForm from '../components/ConsultForm.jsx';
import { CONSULT_URL } from '../config.js';
---
<Base title="상담 신청" description="중국어 회화와 발음 교정 상담을 신청하세요. 이름과 연락처를 남겨 주시면 확인 후 연락드립니다." path={CONSULT_URL}>
  <Header client:load active={CONSULT_URL} />
  <main id="main-content" tabindex="-1">
    <section class="section consult-page">
      <div class="container consult-page__container">
        <SectionTitle as="h1" lead="이름과 연락처를 남겨 주세요. 확인 후 연락드릴게요.">상담 신청</SectionTitle>
        <ConsultForm client:load />
      </div>
    </section>
  </main>
  <Footer />
</Base>
